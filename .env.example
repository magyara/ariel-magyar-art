# Copy to .env and fill in. Never commit .env.
# These same variables must also be set in the Vercel dashboard
# (Settings → Environment Variables) for Production, Preview, and Development.

# --- Database (required) -----------------------------------------------------
# Neon/Lakebase Postgres. The pooled URL is what the API routes use; they throw
# at startup without it. Copy both from the Neon dashboard → Connect.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon branch the URLs above point at. Not read by the app — a convenience for
# CLI work, so you can tell which branch your local .env is aimed at.
NEON_BRANCH=development

# --- Instagram feed (optional) ----------------------------------------------
# Long-lived Instagram access token. Leave blank and /api/instagram returns an
# empty list, and the homepage hides its Instagram section entirely.
IG_ACCESS_TOKEN=
